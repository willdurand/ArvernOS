###############################################################################
# Configuration
###############################################################################

###############################################################################
# Tools
###############################################################################

###############################################################################
# Options for the different tools
###############################################################################

QEMU_OPTIONS += -M microvm -display none
QEMU_OPTIONS += -m 512M
# Keep the live output on the terminal and mirror it to the log file so that it
# can be reviewed (and printed in CI).
QEMU_OPTIONS += -chardev stdio,id=serial0,logfile=$(log_file)
QEMU_OPTIONS += -serial chardev:serial0

###############################################################################
# Source files
###############################################################################

libk_c_files       += $(wildcard $(board_src)/*.c)
libk_c_files       += $(wildcard $(board_src)/arch/*.c)
libk_c_files       += $(wildcard $(board_src)/core/*.c)
libk_asm_files     += $(wildcard $(board_src)/asm/*.asm)

###############################################################################
# Flags
###############################################################################

KERNEL_INCLUDES += -I$(board_src)/

###############################################################################
# Board-specific targets
###############################################################################

arch-debug: $(kernel) $(initrd)
.PHONY: arch-debug

arch-run-debug: debug
	$(progress) "RUN" $(kernel)
	$(QEMU) -kernel $(kernel) -append $(KERNEL_CMDLINE) -initrd $(initrd) $(QEMU_OPTIONS)
.PHONY: arch-run-debug

arch-release: $(kernel) $(initrd)
.PHONY: arch-release

arch-run-release: release
	$(progress) "RUN" $(kernel)
	$(QEMU) -kernel $(kernel) -append $(CMDLINE) -initrd $(initrd) $(QEMU_OPTIONS)
.PHONY: arch-run-release
